  "components": {
    "schemas": {
      "HealthCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 10
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "nullable": true
              }
            }
          }
        },
        "required": [
          "services",
          "status"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PaginatedUserList": {
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "example": 123
          },
          "next": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=4"
          },
          "previous": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=2"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "properties": {
          "new_password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          },
          "confirm_password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          }
        },
        "required": [
          "confirm_password",
          "new_password"
        ]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequestRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "PatchedUserProfileRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "Ім'я: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "description": "Прізвище: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email: локальна частина 1–35, домен 3–35, без послідовних крапок",
            "maxLength": 71
          },
          "avatar": {
            "type": "string",
            "format": "binary",
            "writeOnly": true
          }
        }
      },
      "PatchedUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "Ім'я: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "description": "Прізвище: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email: локальна частина 1–35, домен 3–35, без послідовних крапок",
            "maxLength": 71
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolesEnum"
            }
          },
          "avatar": {
            "type": "string",
            "format": "binary",
            "writeOnly": true
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email: локальна частина 1–35, домен 3–35, без послідовних крапок",
            "maxLength": 71
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "Ім'я: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "description": "Прізвище: 1–50 символів, кирилиця/латиниця, дефіс (не на початку/кінці)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          },
          "password_confirm": {
            "type": "string",
            "writeOnly": true,
            "minLength": 1
          },
          "avatar": {
            "type": "string",
            "format": "binary",
            "writeOnly": true
          },
          "agree_terms": {
            "type": "boolean"
          }
        },
        "required": [
          "agree_terms",
          "email",
