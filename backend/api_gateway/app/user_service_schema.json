  "components": {
    "schemas": {
      "HealthCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "maxLength": 10
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "nullable": true
              }
            }
          }
        },
        "required": [
          "services",
          "status"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PaginatedUserList": {
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "example": 123
          },
          "next": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=4"
          },
          "previous": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "http://api.example.org/accounts/?page=2"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "PasswordResetConfirm": {
        "type": "object",
        "properties": {
          "new_password": {
            "type": "string",
            "writeOnly": true
          },
          "confirm_password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "confirm_password",
          "new_password"
        ]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "PatchedUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "username": {
            "type": "string",
            "description": "\u0406\u043c'\u044f: 1\u201350 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432, \u043a\u0438\u0440\u0438\u043b\u0438\u0446\u044f/\u043b\u0430\u0442\u0438\u043d\u0438\u0446\u044f, \u0434\u0435\u0444\u0456\u0441 (\u043d\u0435 \u043d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443/\u043a\u0456\u043d\u0446\u0456)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50,
            "minLength": 1
          },
          "surname": {
            "type": "string",
            "description": "\u041f\u0440\u0456\u0437\u0432\u0438\u0449\u0435: 1\u201350 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432, \u043a\u0438\u0440\u0438\u043b\u0438\u0446\u044f/\u043b\u0430\u0442\u0438\u043d\u0438\u0446\u044f, \u0434\u0435\u0444\u0456\u0441 (\u043d\u0435 \u043d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443/\u043a\u0456\u043d\u0446\u0456)",
            "pattern": "^(?!-)[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+(-[A-Za-z\\u0410-\\u042f\\u0430-\\u044f\\u0457\\u0407\\u0456\\u0406\\u0454\\u0404\\u0491\\u0490]+)*(?<!-)$",
            "maxLength": 50,
            "minLength": 1
          },
          "email": {
            "type": "string",
            "description": "Email: \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0430 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 1\u201335, \u0434\u043e\u043c\u0435\u043d 3\u201335, \u0431\u0435\u0437 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0438\u0445 \u043a\u0440\u0430\u043f\u043e\u043a",
            "maxLength": 71
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolesEnum"
            }
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "writeOnly": true
          }
        }
      },
