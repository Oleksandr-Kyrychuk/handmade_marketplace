          {
            "in": "query",
            "name": "is_verified",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "roles",
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "admin",
                  "user"
                ],
                "type": "string",
                "description": "* `user` - User\n* `admin` - Admin"
              }
            },
            "description": "* `user` - User\n* `admin` - Admin"
          },
          {
            "in": "query",
            "name": "username",
            "schema": {
              "type": "string"
            }
