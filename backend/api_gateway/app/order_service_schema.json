  "components": {
    "schemas": {
      "Cart": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1
          }
        }
      },
      "CartRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "customer": {
            "type": "object",
            "additionalProperties": {},
            "readOnly": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "readOnly": true
          },
          "total_amount": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "readOnly": true
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "payment": {
            "type": "object",
            "additionalProperties": {},
            "readOnly": true
          },
          "shipping": {
            "type": "object",
            "additionalProperties": {},
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "customer",
          "id",
          "items",
          "payment",
          "shipping",
          "total_amount",
          "updated_at"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_name": {
            "type": "string",
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 0
          },
          "price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$"
          },
          "discount_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "nullable": true
          }
        }
      },
      "OrderItemRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 0
          },
          "price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$"
          },
          "discount_price": {
            "type": "string",
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "nullable": true
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          }
        }
      },
      "PatchedCartRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1
          }
        }
      },
      "PatchedOrderRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          }
        }
      },
      "StatusEnum": {
        "enum": [
          "pending",
          "reserved",
          "paid",
          "processing",
          "shipped",
          "delivered",
          "cancelled",
          "refunded",
          "failed"
        ],
        "type": "string",
        "description": "* `pending` - Pending\n* `reserved` - Reserved\n* `paid` - Paid\n* `processing` - Processing\n* `shipped` - Shipped\n* `delivered` - Delivered\n* `cancelled` - Cancelled\n* `refunded` - Refunded\n* `failed` - Failed"
      }
    },
    "securitySchemes": {
      "basicAuth": {
